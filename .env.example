# Copy this file to `.env.local` and adjust as needed.
# `.env.local` is gitignored (it may hold machine-specific values); this example
# is committed so others know what settings the app understands.

# Data source for the site:
#   db    → read persisted history from the SQLite store (how the site runs)
#   live  → scan the node directly on each request
#   mock  → deterministic placeholder data (no node/DB needed)
ECASH_SOURCE=db

# Persistent history store: a local SQLite file (Node's built-in node:sqlite).
# Optional — defaults to ./.data/dcft.sqlite. Set to relocate.
DCFT_DB=.data/dcft.sqlite

# (Legacy) Live toggle, used only when ECASH_SOURCE is unset.
ECASH_LIVE=1

# Mainchain JSON-RPC. Defaults match a stock BitWindow L2L-Signet install;
# override for your own node.
ECASH_RPC_URL=http://127.0.0.1:38332
ECASH_RPC_USER=user
ECASH_RPC_PASS=password

# How many recent L1 blocks the indexer backfills on its FIRST run (~144/day).
# Later runs only fetch blocks newer than what's already stored.
ECASH_SCAN_BLOCKS=432
