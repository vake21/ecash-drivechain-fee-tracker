# /etc/systemd/system/ecashmeter-index.service
#
# One indexing pass. Driven by ecashmeter-index.timer — do not "enable" this unit
# itself, enable the timer.
#
# Type=oneshot means systemd will not start a second pass while one is running,
# so overlapping runs are impossible without any locking of our own.
[Unit]
Description=eCash Meter indexer — scan new L1 blocks into SQLite
Documentation=https://github.com/vake21/ecash-meter
After=bitcoind.service
Wants=bitcoind.service

[Service]
Type=oneshot
User=ecashmeter
Group=ecashmeter
WorkingDirectory=/srv/ecashmeter
# This one DOES carry the RPC credentials.
EnvironmentFile=/etc/ecashmeter/indexer.env
ExecStart=/usr/bin/npm run index
# A pass takes well under a second on signet; if it hangs, something is wrong.
TimeoutStartSec=600

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ecashmeter
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
