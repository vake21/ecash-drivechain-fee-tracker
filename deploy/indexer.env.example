# Install at /etc/ecashmeter/indexer.env  (chmod 0640, root:ecashmeter)
#
# Environment for ecashmeter-index.service. This file HOLDS A SECRET — the RPC
# password. Keep it out of git; only the .example belongs in the repo.

NODE_ENV=production

ECASH_SOURCE=db
ECASH_METER_DB=/var/lib/ecashmeter/ecash-meter.sqlite

# bitcoind on this same box. RPC is bound to localhost only.
ECASH_RPC_URL=http://127.0.0.1:38332

# Must match the rpcauth= line in /etc/bitcoin/bitcoin.conf. Generate both with
# Core's contrib/rpcauth/rpcauth.py: it prints the rpcauth line for bitcoin.conf
# and the plaintext password for here.
#
# Do NOT leave these as user/password — lib/rpc.ts warns about exactly that, and
# on a public host it is a real hole even bound to localhost.
ECASH_RPC_USER=ecashmeter
ECASH_RPC_PASS=REPLACE_ME

# Give up on a hung RPC rather than holding the timer's slot open.
ECASH_RPC_TIMEOUT_MS=30000

# FIRST RUN ONLY, and it matters: this defaults to 432 blocks (~3 days), which
# would leave the 30-day chart nearly empty on launch day. The whole L2L-Signet
# chain is only ~7,300 blocks / ~26MB and indexes in well under a second, so
# backfill all of it. Subsequent runs resume from the stored tip and ignore this.
ECASH_BACKFILL_BLOCKS=20000
