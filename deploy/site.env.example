# Install at /etc/ecashmeter/site.env  (chmod 0640, root:ecashmeter)
#
# Environment for ecashmeter.service (the web app). It reads the SQLite store and
# nothing else, so it deliberately carries NO RPC credentials.

NODE_ENV=production

# Read persisted history. Never "live" in production: that would make every page
# render hit the node, and the site would go down whenever bitcoind did.
ECASH_SOURCE=db

# Absolute path — systemd services do not inherit a working-directory-relative
# default reliably, and the store lives outside the app directory so a redeploy
# cannot wipe it.
ECASH_METER_DB=/var/lib/ecashmeter/ecash-meter.sqlite
